{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export PORT=${PORT:-3002} && export NODE_ENV=development && node ./build.mjs && node --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node ./build-seed.mjs && node ./dist-seed/seed.mjs",
    "backfill:trust": "node ./build-backfill-trust.mjs && node ./dist-backfill-trust/backfill-trust-scores.mjs"
  },
  "dependencies": {
    "@types/multer": "^2.1.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "grammy": "^1.42.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "openai": "^6.38.0",
    "pino": "^9",
    "pino-http": "^10",
    "sharp": "^0.34.5",
    "ws": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.18.1",
    "esbuild": "0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "typescript": "catalog:"
  }
}
